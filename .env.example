# Coolify ---------------------------------------------------------------------
COOLIFY_URL=http://2.28.117.37:8000
COOLIFY_TOKEN=            # Coolify → Keys & Tokens → API tokens (read+write)
COOLIFY_SERVER_UUID=      # optional; if empty, resolved by name "localhost" at startup
COOLIFY_PROJECT_UUID=     # optional; if empty, the first project is used
COOLIFY_ENVIRONMENT=production
COOLIFY_S3_STORAGE_UUID=  # optional; required for backup scheduling

# Databases -------------------------------------------------------------------
PUBLIC_HOST=2.28.117.37   # host used in public connection strings
PORT_RANGE_START=5432
PORT_RANGE_END=5441
DEFAULT_PG_IMAGE=postgres:18-alpine

# Firewall --------------------------------------------------------------------
# Both optional, but only useful together. Set them to manage per-database IP
# allowlists from the app; leave them empty and the allowlist UI stays hidden.
HCLOUD_TOKEN=             # Hetzner Cloud API token, read AND write
HCLOUD_FIREWALL_ID=       # numeric id from the firewall's URL in the console

# TLS gateway -----------------------------------------------------------------
# Optional. Set PG_GATEWAY_HOST to the SNI hostname Traefik routes to the
# Postgres gateway on 443, and databases become reachable from anywhere without
# a firewall rule — including from serverless platforms, whose egress addresses
# an allowlist cannot express. Leave it blank and the gateway never starts.
# Publish PGPROXY_PORT as 127.0.0.1:<port>:<port>, never <port>:<port>.
PG_GATEWAY_HOST=          # e.g. pg.example.com
PGPROXY_PORT=5433

# Connected projects ----------------------------------------------------------
# Optional. Set VERCEL_TOKEN and the app can push a database's connection string
# straight into a Vercel project's environment variables. Leave it blank and the
# Connected projects card stays hidden and no Vercel call is ever made.
# The token can write env vars into every project it can see — scope it to one
# team and mark it secret.
VERCEL_TOKEN=             # Vercel → Account Settings → Tokens
VERCEL_TEAM_ID=           # required if the projects belong to a team

# Auth ------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=      # npm run hash-password -- '<password>'
SESSION_SECRET=           # 32+ random characters: openssl rand -hex 32

# App -------------------------------------------------------------------------
APP_ORIGIN=https://db.example.com   # used for the CSRF origin check
PORT=3000
DATA_DIR=/data            # persistent volume; SQLite lives at $DATA_DIR/app.db
NODE_ENV=production
